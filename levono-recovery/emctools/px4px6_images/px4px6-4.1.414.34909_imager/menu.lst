# grub.conf generated by anaconda
#
# Note that you do not have to rerun grub after making changes to this file
# NOTICE:  You have a /boot partition.  This means that
#          all kernel and initrd paths are relative to /boot/, eg.
#          root (hd0,1)
#          kernel /vmlinuz-version ro root=/dev/VolGroup00/LogVol00
#          initrd /initrd-version.img
#boot=/dev/sda
default=0
timeout=5
#splashimage=(hd0,1)/grub/splash.xpm.gz
hiddenmenu
title SOHO
	root (hd0,0)
	kernel /images/vmlinuz console=ttyS0,115200 loglevel=0
	initrd /images/initrd
title SOHORecovery
	root (hd0,0)
	kernel /recovery_images/vmlinuz recover
	initrd /recovery_images/initrd
title SOHODEEP
	root (hd0,0)
	kernel /images/vmlinuz depp console=ttyS0,115200
	initrd /images/initrd
title SOHOFactoryReset
	root (hd0,0)
	kernel /images/vmlinuz reset console=ttyS0,115200
	initrd /images/initrd
